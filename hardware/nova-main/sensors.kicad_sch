	(text "VL53L4CD (1–1300 mm, 18° FoV) on the bottom side, ≈ 27 mm above the table, at the front corners.\nXSHUT pulled down: both start off; firmware enables one at a time and moves its address\n(0x29 → 0x30/0x31; the head VL53L1X keeps 0x29). GPIO1 (open-drain) → CLIFF_INT (pull-up on sheet 4).\nMeasures the table distance; a jump of > 15 mm = edge. Works on dark and glossy tables."
		(exclude_from_sim no)
		(at 25.4 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c572fe76-6353-5052-bd03-b8976d273ab4")
	)
